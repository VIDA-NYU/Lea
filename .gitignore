.DS_Store
node_modules/
dist/
.venv/
__pycache__/
.pytest_cache/
test-results/
playwright-report/
*.pyc
.lake/

# Environment files — all variants, but keep tracked templates
.env
.env.*
!.env.example
!.env.*.example

# Common secret material (defense in depth)
*.key
*.pem
*.token
.gemini_key
.github_token
*credentials*.json
*secret*.json

# App-local generated state & private config (location-independent,
# so each workspace's files are ignored wherever it lives in the tree)
.overleaf-lean-stub/
lea.local.toml
data/
/apps/lea-standalone/workspace-state/

# LaTeX build artifacts (docs/ testing fixtures are compiled locally;
# only the .tex sources belong in git)
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
docs/*.log
docs/*.pdf

# Documentation used only for coding-agent navigation and instructions
AGENTS.md
CLAUDE.md

# Local Impeccable skill, hooks, and generated design context
/.agents/skills/impeccable/
/.codex/hooks.json
/.impeccable/
/.release-artifacts/
/PRODUCT.md
/DESIGN.md
