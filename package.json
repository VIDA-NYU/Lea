{
  "name": "lea-ecosystem",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "update-lean-deps": "node scripts/setup.mjs --refresh-lean-deps",
    "start:adapter": "node scripts/supervisor.mjs adapter",
    "dev:overleaf": "npm start -w apps/overleaf-extension",
    "dev:ui": "npm run dev -w apps/lea-standalone",
    "doctor": "npm run doctor -w apps/overleaf-extension && npm run doctor -w apps/lea-standalone",
    "reset:local": "node scripts/reset-local-state.mjs",
    "site:dev": "node public/serve.mjs --watch",
    "site:build": "node public/build.mjs",
    "site:test": "node --test \"public/tests/*.test.mjs\"",
    "test:scripts": "node --test scripts/*.test.mjs apps/lea-standalone/scripts/lean-assets.test.mjs",
    "test": "npm run test:scripts && npm test -w apps/overleaf-extension && npm run test:frontend -w apps/lea-standalone",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:browser": "playwright test -c tests/browser/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
