LEA_ROOT=apps/lea-standalone/prover
# The standalone adapter is the single backend for both apps; it runs on :8001.
LEA_API_BASE_URL=http://127.0.0.1:8001
LEA_API_KEY=
LEA_UI_BASE_URL=http://localhost:5173
OVERLEAF_COMPANION_URL=http://127.0.0.1:31245

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_BASE_URL=

# Bootstrap/fallback values used by setup and the Overleaf companion. The
# adapter's live shared defaults are persisted in
# apps/lea-standalone/config/lea.local.toml; an interactive run also snapshots
# the model selected in the Lea UI when it is submitted.
LEA_PROVIDER=openai
LEA_MODEL=o4-mini
LEA_MAX_TURNS=20
LEA_MAX_SPEND_USD=
LEA_JOB_TIMEOUT_SECONDS=900
LEA_NARRATE_TOOL_STEPS=true
# Emergency compatibility escape hatch for model-authored legacy files. Leave
# unset so Lea rejects the expensive umbrella `import Mathlib`.
# LEA_ALLOW_BROAD_MATHLIB_IMPORT=1
