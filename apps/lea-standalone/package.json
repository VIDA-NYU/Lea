{
  "name": "lea-interface",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/doctor.mjs",
    "reset:local": "node scripts/reset-local-state.mjs",
    "test:frontend": "node --test src/app/*.test.mjs",
    "setup:api": "node scripts/setup-api.mjs",
    "setup:agent": "cd prover && uv sync",
    "dev:web": "vite",
    "start:api": "cd adapter && ./.venv/bin/python run_api.py",
    "dev:api": "cd adapter && ./.venv/bin/python run_api.py",
    "dev:api:venv": "cd adapter && ./.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port ${LEA_ADAPTER_PORT:-8001} --loop asyncio --http h11 --log-level debug",
    "typecheck": "tsc --noEmit"
  },
